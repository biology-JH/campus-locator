{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(api|data|db|_next)(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)\\.(js|css|png|jpg|jpeg|svg|ico|json|txt)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
